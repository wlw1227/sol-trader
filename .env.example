# Trader MK3 — environment variables
# Copy to .env and fill in your values

# Private key (base58) for the trading wallet
PRIVKEY_BASE58=

# Solana RPC endpoint
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Alpha index PostgreSQL database
ALPHA_INDEX_DB_URL=postgresql://root:alphaindex@localhost:5432/alpha_index

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Signal server
SIGNAL_WS_URL=ws://localhost:4000
WS_SERVER_PORT=4000

# Trading parameters
SLIPPAGE_BPS=200
PRIORITY_MICRO_LAMPORTS=1000000
TAKE_PROFIT_MULTIPLE=1.5
POSITION_PCT=0.02
MAX_PER_TRADE_SOL=

# TP watcher
TP_CHECK_INTERVAL_MS=15000
MAX_POSITION_AGE_MINUTES=60

# Dry-run mode (DRY or LIVE)
MODE=DRY

# Paper trade mode for alpha_signal_detector: detects signals and sends
# Telegram alerts but does NOT forward signals to the WebSocket (no real
# trades). Each signal is logged to data/paper_trades.json with a Jupiter
# entry price snapshot. Run `npm run paper-tracker` alongside to track
# simulated P&L, TP hits, stops, and get a daily 9am UTC summary.
# Tokens are recorded in traded_mints.json so they won't re-trigger when
# you switch to live.
PAPER_TRADE=true
